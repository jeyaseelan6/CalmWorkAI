# ========================================================
# CALMWORK AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# 1. Google Gemini AI Settings
# In Development: Use Gemini API Key from https://aistudio.google.com/app/apikey
# In Production: Leave blank and set USE_VERTEX_AI=true with Workload Identity / ADC
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# 2. Google Cloud Platform (GCP) & ADK Multi-Agent Architecture
GCP_PROJECT_ID="your-gcp-project-id"
GCP_LOCATION="us-central1"
USE_VERTEX_AI=false
ADK_APP_NAME="calmwork-ai"
ADK_SESSION_STORAGE="memory"  # "memory" for local dev/testing, "database" for persistent Cloud SQL/Postgres
ENABLE_ADK_TRACING=false
USE_CLOUD_DLP_API=false
GCS_BUCKET_NAME="calmwork-documents-bucket"

# 3. Application & Security Configuration
PROJECT_NAME="CalmWork AI"
VERSION="1.0.0"
LOG_LEVEL="INFO"
PRIVACY_GUARDRAIL_ENABLED=true
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 4. Database Connection
# Local Development: sqlite:///./calmwork.db
# Production Cloud SQL: postgresql+asyncpg://user:password@/calmwork_db?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL="sqlite:///./calmwork.db"
